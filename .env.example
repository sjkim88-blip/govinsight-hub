# 로컬에서 crawler/notify.py 를 직접 실행할 때 필요한 환경변수.
# 실제 값은 .env 에 넣고 절대 커밋하지 말 것(.gitignore 처리됨).
# GitHub Actions 운영 환경에서는 이 값들을 .env 대신 저장소 Settings
# > Secrets and variables > Actions 에 등록한다(.github/workflows/daily_update.yml 참고).

# Gmail 발신 계정 (앱 비밀번호 사용 — 일반 로그인 비밀번호 아님)
SMTP_USER=
SMTP_PASS=

# 신규 공고 알림 수신 이메일, 쉼표로 여러 명 구분 가능 (예: a@co.kr,b@co.kr)
NOTIFY_TO=
